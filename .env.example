# Copy to .env. Everything here is optional; defaults are shown.

# Display: preview (writes data/display.png) | inky | waveshare
DISPLAY_BACKEND=preview
DISPLAY_WIDTH=800
DISPLAY_HEIGHT=480
# WAVESHARE_MODEL=epd7in5_V2

# Camera
CAMERA_ID=0
PREFER_EXTERNAL_CAMERA=true
CAMERA_FPS=10

# Motion gate
MOTION_PIXEL_THRESHOLD=0.5
ACTIVE_WINDOW_SECONDS=4.0

# Faces and hostility
FACE_MIN_WIDTH_PX=80
FACE_MIN_SHARPNESS=30
HOSTILITY_GAIN=2.0

# Visits and display refresh
BURST_GAP_SECONDS=2.5
MIN_REFRESH_INTERVAL_SECONDS=180

LOG_LEVEL=INFO
