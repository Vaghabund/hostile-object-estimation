# Copy to .env. Everything here is optional; defaults are shown.

# Display: preview (writes data/display.png) | waveshare
DISPLAY_BACKEND=preview
DISPLAY_WIDTH=800
DISPLAY_HEIGHT=480
# WAVESHARE_MODEL=epd7in5_V2

# Camera
CAMERA_ID=0
PREFER_EXTERNAL_CAMERA=true
CAMERA_FPS=30

# Motion gate
MOTION_PIXEL_THRESHOLD=0.5
ACTIVE_WINDOW_SECONDS=4.0

# Faces and hostility
FACE_MIN_WIDTH_PX=160
FACE_MIN_SHARPNESS=30
HOSTILITY_GAIN=2.0

# Visits and display refresh
BURST_GAP_SECONDS=2.5
BURST_SHARPNESS_RATIO=0.6
MIN_REFRESH_INTERVAL_SECONDS=180

# Mood barometer window
MOOD_WINDOW_HOURS=24

# Telegram (optional): each picture shown on the panel is sent to this chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Most pictures in the /review grid
# REVIEW_MAX_PICTURES=25

LOG_LEVEL=INFO
