# Copy this file to .env and fill in your values.
# The Telegram token + user ID are best set by running the interactive setup:
#   ./deploy.sh --setup      (or:  python3 src/setup.py)
# Everything else is optional and has sensible defaults shown below.

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
AUTHORIZED_USER_ID=your_telegram_user_id_here

# Camera Configuration
CAMERA_ID=0
PREFER_EXTERNAL_CAMERA=true
CAMERA_PROBE_LIMIT=3

# Motion Detection Configuration
MOTION_CANNY_LOW=50
MOTION_CANNY_HIGH=150
MOTION_PIXEL_THRESHOLD=0.5
MOTION_COOLDOWN=2.0
# Downscale factor before motion detection (0.5 => ~4x less CPU, sensitivity unchanged)
MOTION_DOWNSCALE=0.5

# YOLO Configuration
YOLO_CONFIDENCE=0.5
DETECTION_STABILITY_FRAMES=2
DETECTION_STABILITY_MAX_MISSES=2

# CPU / Threading
# Cap OpenCV + PyTorch worker threads. Defaults to all logical cores; set lower
# (e.g. 2) on weak/old CPUs. Leave unset to use the default.
# CPU_THREADS=2

# Frame Post-Processing (Best-Frame Selection)
FRAME_SELECTION_ENABLED=true
FRAME_SELECTION_ALERTS=true
FRAME_SELECTION_SCAN=true
FRAME_SELECTION_SUMMARY=true
FACE_DETECTOR_TYPE=cascade
FRAME_SCORE_FACE_WEIGHT=1.0
FRAME_SCORE_SHARPNESS_WEIGHT=0.8
FRAME_SCORE_CONFIDENCE_WEIGHT=0.5
FRAME_BUFFER_MAX=30
FRAME_SELECTION_MAX_SCORED=18
FRAME_SELECTION_FACE_MAX_WIDTH=320

# Analytics (SQLite persistence + pattern-of-life analysis: /report, /heatmap, /digest)
ANALYTICS_DB_PATH=data/analytics.db
ANALYTICS_RETENTION_DAYS=30
# Named regions of interest, normalized 0-1 rects "name:x1,y1,x2,y2;name2:x1,y1,x2,y2".
# Used for zone/direction tracking. Empty = disabled.
ZONES=

# Alerting: which classes push immediately vs only show up in the digest/report
ALERT_PRIORITY_CLASSES=person
ALERT_DIGEST_ENABLED=true
ALERT_DIGEST_INTERVAL_MINUTES=60

# Anomaly-based promotion: non-priority classes still alert immediately when they
# deviate from the learned baseline (novel hour-of-day, outlier dwell time)
ANOMALY_DETECTION_ENABLED=true
ANOMALY_MIN_HISTORY_DAYS=3
DWELL_OUTLIER_MIN_SAMPLES=5

# Sequence correlation, e.g. "vehicle arrival with occupant"
SEQUENCE_TARGET_CLASS=person
SEQUENCE_VEHICLE_CLASSES=car,truck,motorcycle,bus
SEQUENCE_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=INFO
